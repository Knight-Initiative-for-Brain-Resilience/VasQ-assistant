# Copy to .env-shared for local use. Never commit the file containing your key.
OPENAI_API_KEY=replace_with_your_own_openai_api_key
# These are the model settings documented for the hosted VasQ workflow.
# Confirm that your API account has access, or choose compatible models.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_HELPER_MODEL=gpt-5.6-luna
OPENAI_WEB_MODEL=gpt-5.6-sol
OPENAI_MAIN_REASONING_EFFORT=high
OPENAI_HELPER_REASONING_EFFORT=none
OPENAI_WEB_REASONING_EFFORT=high
# Set a long, private value for a public deployment.
# DJANGO_SECRET_KEY=replace_with_a_long_random_secret
# Deployment domains, as comma-separated lists (no scheme in ALLOWED_HOSTS).
# ALLOWED_HOSTS=localhost,127.0.0.1,your-service.up.railway.app
# CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,https://your-service.up.railway.app
